{
  "manifest_version": 3,
  "name": "Recall",
  "version": "1.0.0",
  "description": "Local-first bookmarking: capture a page with its context, then find it again by describing it.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms", "notifications"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture the current page to Recall"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture to Recall",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
